# Password you type to unlock Centauri
APP_PASSWORD=change-me
# Random secret (32+ chars) used to sign the login cookie. Generate: openssl rand -base64 48
AUTH_SECRET=
# Neon Postgres connection string (added automatically by the Vercel Neon integration).
# Leave empty locally to use an embedded PGlite database in ./.pglite
DATABASE_URL=
# Vercel Blob token (added automatically when you connect a Blob store)
BLOB_READ_WRITE_TOKEN=
# "private" (default, recommended) or "public" — must match how the Blob store was created
BLOB_ACCESS=private
# Neon AI Gateway (optional): AI reading of messy tickets. `neon deploy` / `neon env pull` writes these to .env.local
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
# Optional model override (any Neon AI Gateway model id). Default: claude-haiku-4-5
AI_MODEL=
